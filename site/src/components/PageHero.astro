---
interface Props { eyebrow: string; title: string; lede: string; crumb: string }
const { eyebrow, title, lede, crumb } = Astro.props;
---
<section class="night">
  <div class="wrap py-16 lg:py-20 grid gap-5">
    <nav aria-label="Breadcrumb" class="text-sm" style="color: var(--night-muted)">
      <a href="/" class="no-underline hover:underline" style="color: var(--night-ink)">Home</a>
      <span aria-hidden="true" class="mx-1.5">›</span><span aria-current="page">{crumb}</span>
    </nav>
    <p class="eyebrow" style="color: var(--amber-bright)">{eyebrow}</p>
    <h1 class="display text-5xl sm:text-6xl leading-[1.03] max-w-[20ch]">{title}</h1>
    <p class="text-lg max-w-[62ch]" style="color: var(--night-muted)">{lede}</p>
    <slot />
  </div>
</section>
